<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#12071f">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server URL"
        android:textColor="#f9a8d4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://192.168.1.x:8080"
        android:textColor="#ffffff"
        android:textColorHint="#666"
        android:backgroundTint="#f472b6"
        android:inputType="textUri"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room ID"
        android:textColor="#f9a8d4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etRoomId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="default-room"
        android:textColor="#ffffff"
        android:textColorHint="#666"
        android:backgroundTint="#f472b6"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Name"
        android:textColor="#f9a8d4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="John, Sarah, Driver-1..."
        android:textColor="#ffffff"
        android:textColorHint="#666"
        android:backgroundTint="#f472b6"
        android:inputType="textPersonName" />

</LinearLayout>
